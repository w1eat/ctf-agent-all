# Generic OpenAI-compatible model endpoint
MODEL_NAME=
API_KEY=
BASE_URL=

# Platform
PLATFORM=auto
PLATFORM_URL=https://ctf.example.com
PLATFORM_LOGIN=false
BROWSER_PROFILE_DIR=.runtime/playwright-profile
BROWSER_DOWNLOAD_DIR=.runtime/downloads
PLATFORM_RECIPE_DIR=.runtime/recipes
CHALLENGE_STATE_DB_PATH=.runtime/challenge_state.sqlite3
CHALLENGE_RUN_ID=
ATTACHMENT_DOWNLOAD_TIMEOUT_SECONDS=60
ATTACHMENT_MAX_RETRIES=3
PREPARATION_CONCURRENCY=4
# Set to 0 to disable coordinator decision timeouts.
COORDINATOR_DECISION_TIMEOUT_SECONDS=180
SOLVER_ATTEMPT_TIMEOUT_SECONDS=1800
SOLVER_MAX_TOOL_STEPS_PER_ATTEMPT=160
SOLVER_MAX_COST_USD=15
FLAG_VERIFICATION_QUORUM=2
KNOWLEDGE_DB_PATH=.runtime/knowledge.sqlite3
KNOWLEDGE_ENABLED=true
EXTERNAL_KNOWLEDGE_ENABLED=true
EXTERNAL_KNOWLEDGE_DIR=.runtime/knowledge
EXTERNAL_KNOWLEDGE_CONTEXT_ITEMS=4
EXTERNAL_KNOWLEDGE_CONTEXT_CHARS=4000
WRITEUP_MODEL_SPEC=
WRITEUP_TIMEOUT_SECONDS=180
WRITEUP_REPLAY_TIMEOUT_SECONDS=120
CHALLENGE_TYPES=[]
PLAYWRIGHT_MCP_COMMAND=
PLAYWRIGHT_MCP_ARGS=["-y","@playwright/mcp@0.0.82"]
PLAYWRIGHT_BROWSER=chrome
PLAYWRIGHT_EXECUTABLE_PATH=
PLAYWRIGHT_HEADLESS=false

# Solver limits
MAX_ATTEMPTS_PER_CHALLENGE=5
MAX_CONCURRENT_CHALLENGES=10

# CTFd
CTFD_URL=https://ctf.example.com
CTFD_TOKEN=ctfd_your_api_token_here

# API Keys (at least one required)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
